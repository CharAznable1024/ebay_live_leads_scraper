{
  "$schema": "https://apify.com/schemas/v1/actor.ide.json",
  "actorSpecification": 1,
  "name": "ebay-live-leads-scraper",
  "title": "eBay Live Lead Scraper",
  "description": "Discovers public eBay Live hosts and seller leads.",
  "version": "0.1",
  "environmentVariables": {
    "BRIGHT_DATA_API_KEY": "@BRIGHT_DATA_API_KEY",
    "BRIGHT_DATA_ZONE": "ebay_live_unlocker"
  },
  "inputSchema": "./input_schema.json",
  "storages": { "dataset": "./dataset_schema.json" },
  "dockerfile": "../Dockerfile",
  "defaultRunOptions": { "build": "latest", "timeoutSecs": 1800, "memoryMbytes": 2048 }
}
